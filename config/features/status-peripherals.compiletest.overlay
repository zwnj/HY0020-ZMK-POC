/*
 * Compile-time integration test for the proposed shared status peripherals:
 * TI BQ27421/BQ27427-family fuel gauge + NCP5623 RGB LED driver on one I2C bus.
 *
 * Battery parameters are representative PoC values only and MUST be replaced
 * with values for the selected cell/charger before hardware use.
 */

#include <zephyr/dt-bindings/led/led.h>

/ {
    chosen {
        zmk,battery = &fuel_gauge;
    };
};

&i2c0 {
    fuel_gauge: bq274xx@55 {
        compatible = "ti,bq274xx";
        reg = <0x55>;
        status = "okay";

        design-voltage = <3700>;
        design-capacity = <1000>;
        taper-current = <100>;
        terminate-voltage = <3300>;
        zephyr,lazy-load;
    };

    status_led: ncp5623@39 {
        compatible = "onnn,ncp5623";
        reg = <0x39>;
        status = "okay";

        rgb_status: led_0 {
            label = "RGB Status";
            index = <0>;
            color-mapping = <LED_COLOR_ID_RED>,
                            <LED_COLOR_ID_GREEN>,
                            <LED_COLOR_ID_BLUE>;
        };
    };
};
