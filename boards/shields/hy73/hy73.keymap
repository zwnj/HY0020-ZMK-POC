#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC            &kp N1             &kp N2             &kp N3             &kp N4             &kp N5
                &kp TAB            &kp Q              &kp W              &kp E              &kp R              &kp T
                &kp CAPS           &kp A              &kp S              &kp D              &kp F              &kp G
                &kp LSHFT          &kp Z              &kp X              &kp C              &kp V              &kp B
                &kp LCTRL          &mo 1              &kp LGUI           &kp LALT           &kp F13            &kp SPACE
                &kp N6             &kp N7             &kp N8             &kp N9             &kp N0             &kp MINUS          &kp EQUAL          &kp BSLH           &kp BSPC
                &kp Y              &kp U              &kp I              &kp O              &kp P              &kp LBKT           &kp RBKT           &kp ENTER          &kp DELETE
                &kp H              &kp J              &kp K              &kp L              &kp SEMI           &kp SQT            &kp RBKT           &kp PAGE_UP
                &kp N              &kp M              &kp COMMA          &kp DOT            &kp FSLH           &kp BSLH           &kp RSHFT          &kp UP_ARROW       &kp PAGE_DOWN
                &kp SPACE          &kp F14            &mo 1              &kp F15            &kp RCTRL          &kp LEFT_ARROW     &kp DOWN_ARROW     &kp RIGHT_ARROW
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
                &trans             &bt BT_CLR         &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3
                &bt BT_SEL 4       &trans             &trans             &trans             &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans
                &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &kp F11            &kp F12            &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans
                &trans             &trans             &trans             &trans             &trans             &trans             &trans             &trans
            >;
        };

        studio_layer_2 {
            status = "reserved";
        };

        studio_layer_3 {
            status = "reserved";
        };
    };
};
