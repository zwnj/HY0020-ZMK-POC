if SHIELD_HY73_LEFT

config ZMK_KEYBOARD_NAME
    default "HY73"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

# LEFT is host-facing over both USB HID and BLE HID.
config ZMK_USB
    default y

config ZMK_BLE
    default y

# Fetch and proxy RIGHT battery level using ZMK's standard split support.
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif

if SHIELD_HY73_LEFT || SHIELD_HY73_RIGHT

config ZMK_SPLIT
    default y

# RIGHT does not enable host BLE HID, so explicitly keep local battery
# reporting enabled for the split battery service/events.
config ZMK_BATTERY_REPORTING
    default y

endif
