config BOARD_ENABLE_DCDC
    bool "Enable HY0020 nRF52832 DC/DC regulator"
    select SOC_DCDC_NRF52X
    default y
    depends on BOARD_HY0020
    help
        Enable the nRF52832 internal DC/DC regulator. The HY0020 hardware
        must follow FDK's reference connection for DCC/DEC4 when this is on.
